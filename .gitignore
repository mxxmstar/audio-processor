# Tauri / Rust
src-tauri/target/
src-tauri/gen/

# Node
node_modules/
dist/

# Python 虚拟环境（依赖体积大，不入库）
# .venv  : 音频识别 + AudioSR（requirements.txt / requirements-ai.txt）
# .venv-flashsr : FlashSR 专用（requirements-flashsr.txt）
#                 两者 numpy 版本冲突（1.23.5 vs 2.2.6），必须分环境
.venv/
.venv-flashsr/
# Python 字节码
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# 图标生成临时源（真正图标在 src-tauri/icons/）
src-tauri/icon-src.png

# Keep test sample
!*.mp3

# 下载产物（音视频文件，体积大，不入库）
*.mp4
*.m4a
*.webm
*.flac
*.mp3
*.wav

# Windows 资源管理器生成的目录配置文件
desktop.ini
# 但保留测试样例音频
!01.*.mp3
!*.sample.mp3

# 运行时资源：保留 bin/ 目录与 fpcalc.exe，忽略 ffmpeg（体积大，由用户自行放置）
!bin/
bin/fpcalc.exe
bin/ffmpeg.exe
bin/ffprobe.exe
bin/ffmpeg
bin/ffmpeg-*
models/*.pt
models/*.pth
# 嵌套子目录权重同样忽略（如 bigvgan-48k/bigvgan_generator.pt），由 manifest source 下载/部署
python/audio_ai_hifigan/models/**/*.pt
python/audio_ai_hifigan/models/**/*.pth
python/audio_ai_hifigan/models/**/*.bin
models/*.ts
models/*.zip
models/*.tar.gz
models/cache/
# 模型下载临时产物：断点续传分片与合并中间文件（FlashSR 单模型约 3.3 GB）
models/**/*.part
models/**/*.parts.*
models/**/*.merge.part
bilidown/
bilidownload/

# 登录态持久化（含 SESSDATA，切勿提交）
src-tauri/auth.json
src-tauri/wbi_cache.json
auth.json
wbi_cache.json

# 下载临时产物（音视频分别下载 / 合并中间文件）
*.audio.m4a
*.video.mp4
*.audio.tmp
*.video.tmp

# 历史记录数据库（本地 SQLite，不入库）
history.db
**/history.db

# 运行日志
*.log
bin/aria2/aria2.log

# Vite 临时文件（配置热重载生成）
vite.config.ts.timestamp-*.mjs
